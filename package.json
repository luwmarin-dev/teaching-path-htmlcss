{
  "name": "codecraft-academy",
  "version": "2.0.0",
  "description": "CodeCraft Academy - 100% Offline Interactive Coding Platform for Kids (HTML/CSS & JavaScript)",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "test": "node --test html-css/tests/*.test.js javascript/tests/*.test.js",
    "test:unit": "node --test html-css/tests/*.test.js javascript/tests/*.test.js",
    "test:e2e": "node --test tests/e2e.test.js",
    "test:all": "node --test html-css/tests/*.test.js javascript/tests/*.test.js tests/e2e.test.js",
    "test:html": "cd html-css && npm test",
    "test:js": "cd javascript && npm test",
    "build": "node html-css/scripts/build.js && node javascript/scripts/build.js",
    "build:html": "cd html-css && npm run build",
    "build:js": "cd javascript && npm run build"
  },
  "keywords": [
    "education",
    "html",
    "css",
    "javascript",
    "kids",
    "offline"
  ],
  "author": "Antigravity & Teacher",
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
